generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  UNIVERSITY
  COMPANY
  OWNER
}

enum Locale {
  EN
  PT
}

enum NotificationType {
  DEADLINE
  ASSIGNMENT
  CAREER
  STARTUP
  ANNOUNCEMENT
  SYSTEM
  ACHIEVEMENT
  PARTNERSHIP
  ENGAGEMENT
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
  DRAFT
  PENDING
  PUBLISHED
  CLOSED
}

enum ClassSessionType {
  LECTURE
  WORKSHOP
  LAB
  SEMINAR
}

enum CalendarLayer {
  ACADEMIC
  CAREER
  STARTUP
  PERSONAL
  SOCIAL
}

enum CalendarQuickType {
  TASK
  EVENT
  STUDY_SESSION
  REMINDER
  MEETING
  EXAM
}

enum CalendarRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum CareerPathStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  REJECTED
}

enum ExamPriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExamContentKind {
  LECTURE
  WORKSHOP
  DOCUMENT
  TOPIC
}

enum ContentItemType {
  SLIDES
  PDF
  VIDEO
  LINK
  EXERCISE
  LAB
  TEMPLATE
  DATASET
  CODE
  NOTES
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum PartnershipStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENT
}

model PlatformConfig {
  id             String   @id @default("platform")
  ownerSlotTaken Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model University {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  coverUrl     String?
  location     String?
  website      String?
  description  String?  @db.Text
  accentColor  String?  @default("230 85% 56%")
  contactEmail String?
  departments  String[]
  plan         String   @default("standard")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admins           UniversityProfile[]
  students         StudentProfile[]
  teachers         TeacherProfile[]
  courses          Course[]
  partnerships     CompanyPartnership[]
  announcements    UniversityAnnouncement[]
  calendarEvents   CalendarEvent[]
  incubatorPrograms IncubatorProgram[]
  careerPaths      CareerPath[]
  activityItems    ActivityItem[]
  internships      Internship[]
  challenges       CompanyChallenge[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  name          String?
  image         String?
  role          UserRole
  locale        Locale    @default(EN)
  headline      String?
  bio           String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  universityProfile UniversityProfile?
  companyProfile    CompanyProfile?

  notifications Notification[]
  accounts      Account[]
  sessions      Session[]

  startupsFounded     Startup[]              @relation("StartupFounder")
  startupMembers      StartupMember[]
  startupInterests    StartupInterest[]      @relation("StartupInterestUser")
  startupFollows      StartupFollower[]      @relation("StartupFollowerUser")
  startupBookmarks    StartupBookmark[]      @relation("StartupBookmarkUser")
  careerTargets       CareerTarget[]
  subjects            SubjectEnrollment[]
  assignments         AssignmentSubmission[]
  subjectAnnouncements SubjectAnnouncement[] @relation("SubjectAnnouncementAuthor")
  subjectMessages     SubjectMessage[]      @relation("SubjectMessageAuthor")
  subjectContentNotes SubjectContentNote[]
  attendanceRecords   SubjectAttendanceRecord[]
  analyticsEvents     AnalyticsEvent[]
  companyPartnerships CompanyPartnership[]   @relation("CompanyUser")
  careerPathsCreated  CareerPath[]           @relation("CareerPathCompany")
  challengesCreated   CompanyChallenge[]     @relation("ChallengeCompany")
  internshipsCreated  Internship[]           @relation("InternshipCompany")
  studentWeeklyClasses StudentWeeklyClass[]
  calendarEvents       StudentCalendarEvent[]
  calendarPreferences  StudentCalendarPreference?
  hiddenCalendarItems  StudentCalendarHidden[]
  examsCreated         Exam[]                   @relation("ExamsCreated")
  examPreparations     StudentExamPreparation[]
}

model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId      String?
  university        University? @relation(fields: [universityId], references: [id])
  courseId          String?
  course            Course?  @relation(fields: [courseId], references: [id])
  universityName    String?
  program           String?
  yearOfStudy       Int?
  profileStrength   Int      @default(0)
  engagementScore   Float    @default(0)
  employabilityScore Float   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  internshipApplications InternshipApplication[]
}

model TeacherProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  department   String?
  title        String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects          Subject[]
  coursesCoordinated Course[] @relation("CourseCoordinator")
}

model UniversityProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  institution  String?
  position     String?
  subRole      String?  @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanyProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  industry    String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id                 String       @id @default(cuid())
  universityId       String
  university         University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name               String
  department         String?
  duration           String?
  degreeType         String?
  coordinatorId      String?
  coordinator        TeacherProfile? @relation("CourseCoordinator", fields: [coordinatorId], references: [id])
  description        String?      @db.Text
  status             RecordStatus @default(ACTIVE)
  engagementScore    Float        @default(0)
  employabilityScore Float        @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  subjects Subject[]
  students StudentProfile[]

  @@index([universityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model Subject {
  id          String       @id @default(cuid())
  universityId String?
  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id])
  name        String
  code        String?
  description String?      @db.Text
  year        Int?
  semester    String?
  teacherId   String?
  teacher     TeacherProfile? @relation(fields: [teacherId], references: [id])
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  enrollments     SubjectEnrollment[]
  assignments     Assignment[]
  exams           Exam[]
  contentWeeks    SubjectContentWeek[]
  announcements   SubjectAnnouncement[]
  scheduleSlots   SubjectScheduleSlot[]
  officeHours     SubjectOfficeHours[]
  attendanceSessions SubjectAttendanceSession[]
  gradeCategories GradeCategory[]
  messages        SubjectMessage[]
  internships     Internship[]
  challenges      CompanyChallenge[]
  studentWeeklyClasses StudentWeeklyClass[]

  @@index([courseId])
}

model SubjectEnrollment {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade      Float?
  attendance Float?
  createdAt  DateTime @default(now())

  @@unique([subjectId, studentId])
}

model Assignment {
  id              String         @id @default(cuid())
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeCategoryId String?
  gradeCategory   GradeCategory? @relation(fields: [gradeCategoryId], references: [id])
  title           String
  description     String?        @db.Text
  dueDate         DateTime
  maxScore        Float          @default(100)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String?    @db.Text
  score        Float?
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, studentId])
}

model Exam {
  id              String    @id @default(cuid())
  subjectId       String?
  subject         Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User      @relation("ExamsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  ownerStudentId  String?
  title           String
  date            DateTime
  endAt           DateTime?
  location        String?
  building        String?
  room            String?
  seatNumber      String?
  onlineUrl       String?
  professor       String?
  description     String?   @db.Text
  difficulty      Int       @default(3)
  weight          Float     @default(1)
  contentVolume   Int       @default(5)
  maxScore        Float     @default(100)
  classAverage    Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  includedContent   ExamIncludedContent[]
  attachments       ExamAttachment[]
  preparations      StudentExamPreparation[]
  personalResources StudentExamPersonalResource[]

  @@index([subjectId, date])
  @@index([createdById])
  @@index([ownerStudentId])
}

model ExamIncludedContent {
  id            String          @id @default(cuid())
  examId        String
  exam          Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  kind          ExamContentKind
  label         String
  contentItemId String?
  sortOrder     Int             @default(0)
  isOfficial    Boolean         @default(true)
  createdById   String
  createdAt     DateTime        @default(now())

  @@index([examId])
}

model ExamAttachment {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String?
  title       String
  url         String?
  fileUrl     String?
  isOfficial  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  @@index([examId])
}

model StudentExamPreparation {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  prepPercent   Float    @default(0)
  lecturesDone  Int      @default(0)
  workshopsDone Int      @default(0)
  documentsDone Int      @default(0)
  revisionsDone Int      @default(0)
  checklist     Json?
  personalNotes String?  @db.Text
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([examId, studentId])
}

model StudentExamPersonalResource {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  title     String
  kind      String
  url       String?
  content   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([examId, studentId])
}

model SubjectContentWeek {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weekNumber Int
  title      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items SubjectContentItem[]

  @@unique([subjectId, weekNumber])
  @@index([subjectId])
}

model SubjectContentItem {
  id           String          @id @default(cuid())
  weekId       String
  week         SubjectContentWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  title        String
  type         ContentItemType @default(PDF)
  url          String?
  fileUrl      String?
  description  String?         @db.Text
  examPriority Boolean         @default(false)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  notes SubjectContentNote[]

  @@index([weekId])
}

model SubjectContentNote {
  id        String   @id @default(cuid())
  itemId    String
  item      SubjectContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note      String?  @db.Text
  updatedAt DateTime @updatedAt

  @@unique([itemId, studentId])
}

model SubjectAnnouncement {
  id          String    @id @default(cuid())
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("SubjectAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String    @db.Text
  priority    String    @default("normal")
  pinned      Boolean   @default(false)
  attachments Json?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([subjectId, publishedAt])
}

model SubjectScheduleSlot {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  label     String?

  @@index([subjectId])
}

model SubjectOfficeHours {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  location  String?

  @@index([subjectId])
}

model SubjectAttendanceSession {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date      DateTime
  label     String?
  createdAt DateTime @default(now())

  records SubjectAttendanceRecord[]

  @@index([subjectId, date])
}

model SubjectAttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  session   SubjectAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(ABSENT)

  @@unique([sessionId, studentId])
}

model GradeCategory {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  weight    Float
  sortOrder Int      @default(0)

  assignments Assignment[]

  @@index([subjectId])
}

model SubjectMessage {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("SubjectMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  channel   String   @default("class")
  body      String   @db.Text
  threadId  String?
  createdAt DateTime @default(now())

  @@index([subjectId, createdAt])
}

model CompanyPartnership {
  id              String            @id @default(cuid())
  universityId    String
  university      University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  companyUserId   String
  companyUser     User              @relation("CompanyUser", fields: [companyUserId], references: [id], onDelete: Cascade)
  status          PartnershipStatus @default(PENDING)
  partnershipType String?
  contactName     String?
  contactEmail    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  careerPaths CareerPath[]

  @@unique([universityId, companyUserId])
  @@index([universityId])
}

model CareerPath {
  id                    String           @id @default(cuid())
  companyUserId         String
  companyUser           User             @relation("CareerPathCompany", fields: [companyUserId], references: [id], onDelete: Cascade)
  universityId          String?
  university            University?      @relation(fields: [universityId], references: [id])
  partnershipId         String?
  partnership           CompanyPartnership? @relation(fields: [partnershipId], references: [id])
  roleTitle             String
  companyName           String
  industry              String?
  description           String?          @db.Text
  requiredSubjects      String[]
  gradeRequirements     String?          @db.Text
  recommendedSkills     String[]
  recommendedInternships String[]
  salaryMin             Int?
  salaryMax             Int?
  compatibilityCriteria String?          @db.Text
  status                CareerPathStatus @default(PENDING_APPROVAL)
  publishedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  targets CareerTarget[]

  @@index([universityId, status])
  @@index([companyUserId])
}

model CareerTarget {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerPathId   String?
  careerPath     CareerPath? @relation(fields: [careerPathId], references: [id])
  roleTitle      String
  companyName    String?
  compatibility  Float       @default(0)
  isPrimary      Boolean     @default(false)
  missingRequirements String? @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([careerPathId])
}

model Internship {
  id            String       @id @default(cuid())
  universityId  String?
  university    University?  @relation(fields: [universityId], references: [id])
  subjectId     String?
  subject       Subject?     @relation(fields: [subjectId], references: [id])
  companyUserId String
  companyUser   User         @relation("InternshipCompany", fields: [companyUserId], references: [id], onDelete: Cascade)
  careerPathId  String?
  title         String
  description   String?      @db.Text
  duration      String?
  location      String?
  status        RecordStatus @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  applications InternshipApplication[]
}

model InternshipApplication {
  id           String   @id @default(cuid())
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@unique([internshipId, studentId])
}

model CompanyChallenge {
  id            String       @id @default(cuid())
  universityId  String?
  university    University?  @relation(fields: [universityId], references: [id])
  subjectId     String?
  subject       Subject?     @relation(fields: [subjectId], references: [id])
  companyUserId String
  companyUser   User         @relation("ChallengeCompany", fields: [companyUserId], references: [id], onDelete: Cascade)
  title         String
  description   String?      @db.Text
  deadline      DateTime?
  status        RecordStatus @default(PENDING)
  featured      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model UniversityAnnouncement {
  id           String             @id @default(cuid())
  universityId String
  university   University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title        String
  message      String             @db.Text
  audience     String
  priority     String             @default("normal")
  status       AnnouncementStatus @default(DRAFT)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([universityId])
}

model CalendarEvent {
  id           String   @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title        String
  eventType    String
  startDate    DateTime
  endDate      DateTime?
  description  String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([universityId, startDate])
}

model IncubatorProgram {
  id           String       @id @default(cuid())
  universityId String
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title        String
  description  String?      @db.Text
  eligibility  String?      @db.Text
  deadline     DateTime?
  location     String?
  mentors      String[]
  companies    String[]
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ActivityItem {
  id           String   @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  type         String
  title        String
  message      String?  @db.Text
  link         String?
  createdAt    DateTime @default(now())

  @@index([universityId, createdAt])
}

model Startup {
  id          String   @id @default(cuid())
  founderId   String
  founder     User     @relation("StartupFounder", fields: [founderId], references: [id], onDelete: Cascade)
  universityId String?
  name        String
  tagline     String?
  description String?  @db.Text
  industry    String?
  stage       String?
  logoUrl     String?
  coverUrl    String?
  website     String?
  linkedIn    String?
  instagram   String?
  twitter     String?
  contactEmail String?
  foundedAt   DateTime?
  lookingFor  String[]
  traction    String?  @db.Text
  featured    Boolean  @default(false)
  watchlisted Boolean  @default(false)
  readinessScore Float @default(0)
  progressPercent Int  @default(0)
  defaultVisibility String @default("PUBLIC")

  problem           String? @db.Text
  targetCustomer    String? @db.Text
  solution          String? @db.Text
  whyNow            String? @db.Text
  differentiator    String? @db.Text
  businessModelText String? @db.Text
  visionOneLiner    String? @db.Text

  revenueModels      String[]
  expectedPricing    String?
  targetCustomersBm  String?
  revenueGoal        String?
  monetizationStage  String?

  targetMarket         String? @db.Text
  marketSizeEstimate   String?
  competitors          String? @db.Text
  currentAlternatives  String? @db.Text

  sectionVisibility Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      StartupMember[]
  media        StartupMedia[]
  milestones   StartupMilestone[]
  tractionMetrics StartupTractionMetric[]
  openings     StartupOpening[]
  interests    StartupInterest[]
  followers    StartupFollower[]
  bookmarks    StartupBookmark[]

  @@index([universityId])
  @@index([industry])
  @@index([stage])
}

model StartupMember {
  id              String   @id @default(cuid())
  startupId       String
  startup         Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String
  photoUrl        String?
  course          String?
  yearOfStudy     Int?
  linkedIn        String?
  bio             String?  @db.Text
  ownershipPercent Float?
  ownershipPrivate Boolean @default(true)
  isMainFounder   Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([startupId, userId])
}

model StartupMedia {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  type      String
  title     String?
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([startupId])
}

model StartupMilestone {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  key       String
  label     String
  status    String   @default("pending")
  date      DateTime?
  proofUrl  String?
  notes     String?  @db.Text
  sortOrder Int      @default(0)

  @@unique([startupId, key])
  @@index([startupId])
}

model StartupTractionMetric {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  metricKey String
  label     String
  value     String?
  isPrivate Boolean  @default(false)

  @@unique([startupId, metricKey])
}

model StartupOpening {
  id             String   @id @default(cuid())
  startupId      String
  startup        Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  role           String
  description    String?  @db.Text
  skillsRequired String[]
  timeCommitment String?
  compensation   String?
  createdAt      DateTime @default(now())
}

model StartupInterest {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("StartupInterestUser", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String?  @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([startupId, userId, type])
  @@index([startupId])
}

model StartupFollower {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("StartupFollowerUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([startupId, userId])
}

model StartupBookmark {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("StartupBookmarkUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([startupId, userId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model StudentCalendarEvent {
  id            String             @id @default(cuid())
  studentId     String
  student       User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  description   String?            @db.Text
  category      CalendarLayer      @default(PERSONAL)
  quickType     CalendarQuickType  @default(EVENT)
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean            @default(false)
  color         String             @default("#6366f1")
  location      String?
  room          String?
  professor     String?
  recurrence    CalendarRecurrence @default(NONE)
  recurrenceMeta Json?
  taggedEmails  String[]
  startupId     String?
  sourceRef     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([studentId, startAt])
  @@index([taggedEmails])
}

model StudentCalendarPreference {
  id                String   @id @default(cuid())
  studentId         String   @unique
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  countdownMinutes  Int[]    @default([10080, 4320, 1440, 720, 120])
  layersEnabled     Json?
  googleSyncEnabled Boolean  @default(false)
  appleSyncEnabled  Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model StudentCalendarHidden {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now())

  @@unique([studentId, sourceType, sourceId])
  @@index([studentId])
}

model StudentWeeklyClass {
  id           String           @id @default(cuid())
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName  String
  classType    ClassSessionType @default(LECTURE)
  professor    String?
  dayOfWeek    Int
  startTime    String
  endTime      String
  repeatWeekly Boolean          @default(true)
  building     String?
  room         String?
  isOnline     Boolean          @default(false)
  color        String           @default("#3b82f6")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([studentId, dayOfWeek])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
