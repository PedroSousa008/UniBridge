generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  UNIVERSITY
  COMPANY
  OWNER
}

enum Locale {
  EN
  PT
}

enum NotificationType {
  DEADLINE
  ASSIGNMENT
  CAREER
  STARTUP
  ANNOUNCEMENT
  SYSTEM
  ACHIEVEMENT
  PARTNERSHIP
  ENGAGEMENT
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
  DRAFT
  PENDING
  PUBLISHED
  CLOSED
}

enum ClassSessionType {
  LECTURE
  WORKSHOP
  LAB
  SEMINAR
}

enum CalendarLayer {
  ACADEMIC
  CAREER
  STARTUP
  PERSONAL
  SOCIAL
}

enum CalendarQuickType {
  TASK
  EVENT
  STUDY_SESSION
  REMINDER
  MEETING
  EXAM
}

enum CalendarRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum CareerPathStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  REJECTED
}

enum ExamPriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExamContentKind {
  LECTURE
  WORKSHOP
  DOCUMENT
  TOPIC
}

enum AssignmentWorkflowStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  LATE
  GRADED
}

enum AssignmentPriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContentItemType {
  SLIDES
  PDF
  VIDEO
  LINK
  EXERCISE
  LAB
  TEMPLATE
  DATASET
  CODE
  NOTES
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum AttendanceJustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PartnershipStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum ResourceScope {
  INTERNAL
  EXTERNAL
}

enum ResourceHubCategory {
  CAREER
  STARTUP
  UNIVERSITY
  SUBJECT
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum AnnouncementCategory {
  ACADEMIC
  DOCUMENTS
  ADMINISTRATIVE
  GROUP_WORK
  UNIVERSITY_WIDE
}

enum AnnouncementPriority {
  INFORMATIONAL
  IMPORTANT
  URGENT
  CRITICAL
}

enum AnnouncementSourceKind {
  MANUAL
  EXAM
  ASSIGNMENT
  ATTENDANCE
  DOCUMENT
  SCHEDULE
  CALENDAR
  GROUP
}

model PlatformConfig {
  id             String   @id @default("platform")
  ownerSlotTaken Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model University {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  coverUrl     String?
  location     String?
  website      String?
  description  String?  @db.Text
  accentColor  String?  @default("230 85% 56%")
  contactEmail String?
  departments  String[]
  plan         String   @default("standard")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admins           UniversityProfile[]
  students         StudentProfile[]
  teachers         TeacherProfile[]
  courses          Course[]
  partnerships     CompanyPartnership[]
  announcements    UniversityAnnouncement[]
  calendarEvents   CalendarEvent[]
  incubatorPrograms IncubatorProgram[]
  careerPaths      CareerPath[]
  activityItems    ActivityItem[]
  internships      Internship[]
  challenges       CompanyChallenge[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  name          String?
  image         String?
  role          UserRole
  locale        Locale    @default(EN)
  headline      String?
  bio           String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  universityProfile UniversityProfile?
  companyProfile    CompanyProfile?

  notifications Notification[]
  accounts      Account[]
  sessions      Session[]

  startupsFounded     Startup[]              @relation("StartupFounder")
  startupMembers      StartupMember[]
  startupInterests    StartupInterest[]      @relation("StartupInterestUser")
  startupFollows      StartupFollower[]      @relation("StartupFollowerUser")
  startupBookmarks    StartupBookmark[]      @relation("StartupBookmarkUser")
  partnershipBookmarks CompanyPartnershipBookmark[]
  internshipBookmarks InternshipBookmark[]
  careerTargets       CareerTarget[]
  subjects            SubjectEnrollment[]
  assignments         AssignmentSubmission[]
  subjectAnnouncements SubjectAnnouncement[] @relation("SubjectAnnouncementAuthor")
  subjectMessages     SubjectMessage[]      @relation("SubjectMessageAuthor")
  subjectContentNotes SubjectContentNote[]
  attendanceRecords   SubjectAttendanceRecord[]
  analyticsEvents     AnalyticsEvent[]
  companyPartnerships CompanyPartnership[]   @relation("CompanyUser")
  careerPathsCreated  CareerPath[]           @relation("CareerPathCompany")
  challengesCreated   CompanyChallenge[]     @relation("ChallengeCompany")
  internshipsCreated  Internship[]           @relation("InternshipCompany")
  studentWeeklyClasses StudentWeeklyClass[]
  calendarEvents       StudentCalendarEvent[]
  calendarPreferences  StudentCalendarPreference?
  hiddenCalendarItems  StudentCalendarHidden[]
  examsCreated         Exam[]                   @relation("ExamsCreated")
  examPreparations     StudentExamPreparation[]
  gradebookPreference  StudentGradebookPreference?
  assignmentProgress   StudentAssignmentProgress[]
  assignmentGroups     AssignmentGroupMember[]
  groupComments          AssignmentGroupComment[]
  documentPreference   StudentDocumentPreference?
  attendanceJustifications AttendanceJustification[]
  teacherAttendanceNotes   TeacherAttendanceNote[] @relation("TeacherAttendanceNoteStudent")
  announcementReads        AnnouncementRead[]
  messageReadStates        StudentMessageReadState[]
  resourcePreference       StudentResourcePreference?
  compatibilitySnapshots   StudentCompatibilitySnapshot[]
  workStyleProfile         StudentWorkStyleProfile?
}

model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId      String?
  university        University? @relation(fields: [universityId], references: [id])
  courseId          String?
  course            Course?  @relation(fields: [courseId], references: [id])
  universityName    String?
  program           String?
  yearOfStudy       Int?
  profileStrength   Int      @default(0)
  engagementScore   Float    @default(0)
  employabilityScore Float   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  internshipApplications InternshipApplication[]
  internshipJournals     StudentInternshipJournal[]
}

model TeacherProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  department   String?
  title        String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects          Subject[]
  coursesCoordinated Course[] @relation("CourseCoordinator")
}

model UniversityProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  institution  String?
  position     String?
  subRole      String?  @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanyProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String?
  industry     String?
  website      String?
  logoUrl      String?
  headquarters String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Course {
  id                 String       @id @default(cuid())
  universityId       String
  university         University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name               String
  department         String?
  duration           String?
  degreeType         String?
  coordinatorId      String?
  coordinator        TeacherProfile? @relation("CourseCoordinator", fields: [coordinatorId], references: [id])
  description        String?      @db.Text
  status             RecordStatus @default(ACTIVE)
  engagementScore    Float        @default(0)
  employabilityScore Float        @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  subjects Subject[]
  students StudentProfile[]

  @@index([universityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model Subject {
  id          String       @id @default(cuid())
  universityId String?
  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id])
  name        String
  code        String?
  description String?      @db.Text
  year        Int?
  semester    String?
  teacherId   String?
  teacher     TeacherProfile? @relation(fields: [teacherId], references: [id])
  status      RecordStatus @default(ACTIVE)
  absenceLimit Int?
  minAttendancePercent Float @default(75)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  enrollments     SubjectEnrollment[]
  attendanceJustifications AttendanceJustification[]
  teacherAttendanceNotes   TeacherAttendanceNote[]
  assignments     Assignment[]
  exams           Exam[]
  contentWeeks    SubjectContentWeek[]
  announcements   SubjectAnnouncement[]
  scheduleSlots   SubjectScheduleSlot[]
  officeHours     SubjectOfficeHours[]
  attendanceSessions SubjectAttendanceSession[]
  gradeCategories GradeCategory[]
  messages        SubjectMessage[]
  internships     Internship[]
  challenges      CompanyChallenge[]
  studentWeeklyClasses StudentWeeklyClass[]

  @@index([courseId])
}

model SubjectEnrollment {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade      Float?
  attendance Float?
  createdAt  DateTime @default(now())

  @@unique([subjectId, studentId])
}

model Assignment {
  id              String         @id @default(cuid())
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdById     String?
  gradeCategoryId String?
  gradeCategory   GradeCategory? @relation(fields: [gradeCategoryId], references: [id])
  title           String
  description     String?        @db.Text
  instructions    String?        @db.Text
  rubric          String?        @db.Text
  dueDate         DateTime
  maxScore        Float          @default(100)
  weightPercent   Float?
  isGroup         Boolean        @default(false)
  allowedFormats  String[]       @default([])
  linksJson       Json?
  professor       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  submissions  AssignmentSubmission[]
  attachments  AssignmentAttachment[]
  progress     StudentAssignmentProgress[]
  groups       AssignmentGroup[]

  @@index([subjectId, dueDate])
}

model AssignmentAttachment {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  title        String
  url          String?
  fileUrl      String?
  kind         String     @default("file")
  createdById  String
  createdAt    DateTime   @default(now())

  @@index([assignmentId])
}

model StudentAssignmentProgress {
  id              String                   @id @default(cuid())
  assignmentId    String
  assignment      Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          AssignmentWorkflowStatus @default(NOT_STARTED)
  progressPercent Int                      @default(0)
  studentWeight   Float?
  notes           String?                  @db.Text
  startedAt       DateTime?
  updatedAt       DateTime                 @updatedAt
  createdAt       DateTime                 @default(now())

  @@unique([assignmentId, studentId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String?    @db.Text
  comment      String?    @db.Text
  linkUrl      String?
  fileUrls     String[]   @default([])
  score        Float?
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
}

model AssignmentGroup {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())

  members  AssignmentGroupMember[]
  tasks    AssignmentGroupTask[]
  files    AssignmentGroupFile[]
  comments AssignmentGroupComment[]

  @@index([assignmentId])
}

model AssignmentGroupMember {
  id        String          @id @default(cuid())
  groupId   String
  group     AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role      String          @default("member")

  @@unique([groupId, studentId])
}

model AssignmentGroupTask {
  id         String          @id @default(cuid())
  groupId    String
  group      AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title      String
  assigneeId String?
  done       Boolean         @default(false)
  sortOrder  Int             @default(0)
}

model AssignmentGroupFile {
  id        String          @id @default(cuid())
  groupId   String
  group     AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  title     String
  url       String?
  createdAt DateTime        @default(now())
}

model AssignmentGroupComment {
  id        String          @id @default(cuid())
  groupId   String
  group     AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  body      String          @db.Text
  createdAt DateTime        @default(now())
}

model Exam {
  id              String    @id @default(cuid())
  subjectId       String?
  subject         Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User      @relation("ExamsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  ownerStudentId  String?
  title           String
  date            DateTime
  endAt           DateTime?
  location        String?
  building        String?
  room            String?
  seatNumber      String?
  onlineUrl       String?
  professor       String?
  description     String?   @db.Text
  difficulty      Int       @default(3)
  weight          Float     @default(1)
  contentVolume   Int       @default(5)
  maxScore        Float     @default(100)
  classAverage    Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  includedContent   ExamIncludedContent[]
  attachments       ExamAttachment[]
  preparations      StudentExamPreparation[]
  personalResources StudentExamPersonalResource[]

  @@index([subjectId, date])
  @@index([createdById])
  @@index([ownerStudentId])
}

model ExamIncludedContent {
  id            String          @id @default(cuid())
  examId        String
  exam          Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  kind          ExamContentKind
  label         String
  contentItemId String?
  sortOrder     Int             @default(0)
  isOfficial    Boolean         @default(true)
  createdById   String
  createdAt     DateTime        @default(now())

  @@index([examId])
}

model ExamAttachment {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String?
  title       String
  url         String?
  fileUrl     String?
  isOfficial  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  @@index([examId])
}

model StudentExamPreparation {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  prepPercent   Float    @default(0)
  lecturesDone  Int      @default(0)
  workshopsDone Int      @default(0)
  documentsDone Int      @default(0)
  revisionsDone Int      @default(0)
  checklist     Json?
  personalNotes String?  @db.Text
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([examId, studentId])
}

model StudentExamPersonalResource {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  title     String
  kind      String
  url       String?
  content   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([examId, studentId])
}

model SubjectContentWeek {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weekNumber Int
  title      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items SubjectContentItem[]

  @@unique([subjectId, weekNumber])
  @@index([subjectId])
}

model SubjectContentItem {
  id           String          @id @default(cuid())
  weekId       String
  week         SubjectContentWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  title        String
  type         ContentItemType @default(PDF)
  url          String?
  fileUrl      String?
  description  String?         @db.Text
  examPriority Boolean         @default(false)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  notes SubjectContentNote[]

  @@index([weekId])
}

model SubjectContentNote {
  id        String   @id @default(cuid())
  itemId    String
  item      SubjectContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note      String?  @db.Text
  updatedAt DateTime @updatedAt

  @@unique([itemId, studentId])
}

model SubjectAnnouncement {
  id              String                 @id @default(cuid())
  subjectId       String
  subject         Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  authorId        String
  author          User                   @relation("SubjectAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  body            String                 @db.Text
  preview         String?                @db.Text
  priority        String                 @default("normal")
  priorityLevel   AnnouncementPriority   @default(INFORMATIONAL)
  category        AnnouncementCategory   @default(ACADEMIC)
  sourceKind      AnnouncementSourceKind @default(MANUAL)
  sourceRef       String?                @unique
  linkHref        String?
  linkLabel       String?
  pinned          Boolean                @default(false)
  attachments     Json?
  taggedUserIds   String[]               @default([])
  taggedGroupIds  String[]               @default([])
  isAutoGenerated Boolean                @default(false)
  pushNotify      Boolean                @default(true)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  reads AnnouncementRead[]

  @@index([subjectId, publishedAt])
  @@index([category])
  @@index([priorityLevel])
}

model AnnouncementRead {
  id                       String                  @id @default(cuid())
  userId                   String
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectAnnouncementId    String?
  subjectAnnouncement      SubjectAnnouncement?    @relation(fields: [subjectAnnouncementId], references: [id], onDelete: Cascade)
  universityAnnouncementId String?
  universityAnnouncement   UniversityAnnouncement? @relation(fields: [universityAnnouncementId], references: [id], onDelete: Cascade)
  readAt                   DateTime                @default(now())

  @@unique([userId, subjectAnnouncementId])
  @@unique([userId, universityAnnouncementId])
  @@index([userId, readAt])
}

model SubjectScheduleSlot {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  label     String?

  @@index([subjectId])
}

model SubjectOfficeHours {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  location  String?

  @@index([subjectId])
}

model SubjectAttendanceSession {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date           DateTime
  label          String?
  canceled       Boolean  @default(false)
  isOnline       Boolean  @default(false)
  movedTo        DateTime?
  scheduleSlotId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  records SubjectAttendanceRecord[]

  @@index([subjectId, date])
}

model SubjectAttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  session   SubjectAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(ABSENT)
  updatedAt DateTime         @updatedAt

  @@unique([sessionId, studentId])
}

model AttendanceJustification {
  id           String                      @id @default(cuid())
  studentId    String
  student      User                        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject                     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sessionId    String?
  reason       String                      @db.Text
  fileUrl      String?
  documentUrl  String?
  status       AttendanceJustificationStatus @default(PENDING)
  teacherNote  String?                     @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([studentId, subjectId])
  @@index([status])
}

model TeacherAttendanceNote {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("TeacherAttendanceNoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, studentId])
}

model GradeCategory {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  weight      Float
  sortOrder   Int      @default(0)
  description String?  @db.Text
  rulesJson   Json?
  minGrade    Float?

  assignments Assignment[]

  @@index([subjectId])
}

model StudentGradebookPreference {
  id                String   @id @default(cuid())
  studentId         String   @unique
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  goodMin           Float    @default(14)
  moderateMin       Float    @default(10)
  passMin           Float    @default(10)
  targetGpa         Float?
  creditsCompleted  Int      @default(0)
  creditsRequired   Int      @default(180)
  ectsPerSubject    Int      @default(6)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model StudentDocumentPreference {
  id                    String   @id @default(cuid())
  studentId             String   @unique
  student               User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hideCompletedSubjects Boolean  @default(false)
  pinnedIds             String[] @default([])
  starredIds            String[] @default([])
  archivedSubjectIds    String[] @default([])
  recentOpens           Json?
  offlineSavedIds       String[] @default([])
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model SubjectMessage {
  id        String   @id @default(cuid())
  subjectId String
