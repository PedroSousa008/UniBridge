# Database (Neon, Supabase, or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/unibridge?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
# On Vercel: set NEXTAUTH_URL to your production URL (e.g. https://unibridge-eight.vercel.app)
# and NEXTAUTH_SECRET to a long random string (openssl rand -base64 32)

# Optional: OpenAI for AI mentor (Phase 1+)
# OPENAI_API_KEY="sk-..."
